{
  "name": "@jamjet/ext-authz",
  "version": "0.2.0",
  "description": "JamJet Policy Decision Point exposed over the Envoy HTTP ext_authz contract. Allow, block, or hold MCP tool calls and emit AgentBoundary receipts, in front of any Envoy-compatible proxy.",
  "type": "module",
  "bin": { "jamjet-ext-authz": "./dist/bin.js" },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/bin.ts --format esm --dts --shims --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jamjet/cloud": "^0.3.1",
    "@jamjet/mcp-threat": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsup": "^8.0.0",
    "vitest": "^2.0.0",
    "@types/node": "^20.0.0"
  },
  "keywords": ["ai-agents", "agent-safety", "mcp", "ext-authz", "envoy", "policy-decision-point", "ai-governance"],
  "license": "Apache-2.0",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "https://github.com/jamjet-labs/jamjet-policy.git", "directory": "packages/ext-authz" }
}
